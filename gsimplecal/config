# Match i3/rofi aesthetic on caliper-01
# palette: bg #1c1c1c · accent #8e44ad · mono JetBrainsMono

show_calendar = 1
show_timezones = 0
show_week_numbers = 0
mark_today = 1

# dismiss when clicking elsewhere / leaving window
close_on_unfocus = 1
close_on_mouseleave = 1

mainwindow_decorated = 0
mainwindow_keep_above = 1
mainwindow_sticky = 1
# skip_taskbar=0 so window can take focus → close_on_unfocus works
mainwindow_skip_taskbar = 0
mainwindow_resizable = 0

# near clock click, shifted left and just under the bar
mainwindow_position = mouse
mainwindow_xoffset = -200
mainwindow_yoffset = 40

clock_font = JetBrainsMono Nerd Font Mono 16
calendar_font = JetBrainsMono Nerd Font Mono 16
