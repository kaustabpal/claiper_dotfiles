#!/usr/bin/env bash
# PipeWire volume helper for i3. Usage: i3-volume up|down|mute|mic
set -euo pipefail

step="${I3_VOLUME_STEP:-5}"

notify() {
  if command -v dunstify >/dev/null 2>&1; then
    dunstify -a volume -r 9911 -u low "$1" "$2" 2>/dev/null || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -a volume "$1" "$2" 2>/dev/null || true
  fi
}

vol_text() {
  wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk '{
    v=int($2*100+0.5)
    if ($0 ~ /MUTED/) print "MUTE " v "%"; else print v "%"
  }'
}

cmd="${1:-}"
case "$cmd" in
  up) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${step}%+" ;;
  down) wpctl set-volume @DEFAULT_AUDIO_SINK@ "${step}%-" ;;
  mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  mic) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
  *)
    echo "Usage: $0 up|down|mute|mic" >&2
    exit 2
    ;;
esac

notify "Volume" "$(vol_text)"
exit 0
