#!/usr/bin/env python3
"""i3status wrapper: clickable clock calendar + GPU temperature block."""
from __future__ import annotations

import json
import os
import subprocess
import sys
import threading
import time
from pathlib import Path

CONFIG = os.path.expanduser("~/.config/i3status/config")
HOME = os.path.expanduser("~")

GPU_COLOR = "#e74c3c"  # red
SEP_COLOR = "#5F676F"  # Pi footer separator
GPU_REFRESH_SEC = 3.0

_gpu_lock = threading.Lock()
_gpu_text = "Temp: --°C"
_gpu_ts = 0.0


def _ensure_gsimplecal_css() -> None:
    return  # disabled; theme via settings.ini
    src = Path(HOME) / ".config/gsimplecal/gtk.css"
    if not src.is_file():
        return
    user_dir = Path(HOME) / ".config/gtk-3.0"
    user_css = user_dir / "gtk.css"
    begin = "/* >>> gsimplecal-i3 begin */"
    end = "/* <<< gsimplecal-i3 end */"
    user_dir.mkdir(parents=True, exist_ok=True)
    existing = user_css.read_text() if user_css.is_file() else ""
    if begin in existing:
        return
    block = f"\n{begin}\n{src.read_text().strip()}\n{end}\n"
    user_css.write_text(existing + block)


def open_calendar() -> None:
    """Toggle/pop a small calendar near the bar (dark theme)."""
    # css injection disabled - theme-only via xsettingsd/settings.ini
    launch = os.environ.copy()
    launch["PATH"] = f"{HOME}/.local/bin:" + launch.get("PATH", "")
    launch["GTK_THEME"] = launch.get("GSIMPLECAL_GTK_THEME", "Yaru-purple-dark")
    launch["GTK_APPLICATION_PREFER_DARK_THEME"] = "1"
    # gsimplecal has no real font keys; size comes from GTK font
    launch["GTK_FONT_NAME"] = launch.get("GSIMPLECAL_GTK_FONT", "Ubuntu Sans 13")
    launch["GDK_BACKEND"] = "x11"

    candidates = [
        [f"{HOME}/.local/bin/gsimplecal-i3"],
        ["gsimplecal"],
        ["gnome-calendar"],
        ["zenity", "--calendar", "--title=Calendar"],
    ]
    for cmd in candidates:
        try:
            subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=launch,
            )
            return
        except FileNotFoundError:
            continue


def read_gpu_temp_c() -> str | None:
    """Return GPU temp in °C via nvidia-smi, or None on failure."""
    try:
        out = subprocess.check_output(
            [
                "nvidia-smi",
                "--query-gpu=temperature.gpu",
                "--format=csv,noheader,nounits",
            ],
            text=True,
            timeout=2.0,
            stderr=subprocess.DEVNULL,
        )
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError):
        return None
    line = out.strip().splitlines()[0].strip() if out.strip() else ""
    if not line:
        return None
    # multi-GPU: first line; allow "56" or "56 C"
    token = line.split(",")[0].strip().split()[0]
    try:
        int(token)
    except ValueError:
        return None
    return token


def gpu_block() -> dict:
    """i3bar block for GPU temperature (cached)."""
    global _gpu_text, _gpu_ts
    now = time.time()
    with _gpu_lock:
        if now - _gpu_ts >= GPU_REFRESH_SEC:
            temp = read_gpu_temp_c()
            _gpu_text = f"Temp: {temp}°C" if temp is not None else "Temp: n/a"
            _gpu_ts = now
        text = _gpu_text
    # Pango: red temp label + Pi-footer-colored | separator
    body = (
        f"<span foreground='{GPU_COLOR}'>{text}</span>"
        f"<span foreground='{SEP_COLOR}'> | </span>"
    )
    return {
        "name": "gpu_temp",
        "instance": "nvidia0",
        "full_text": f"  {body}",
        "markup": "pango",
        "separator": False,
        "separator_block_width": 0,
    }


def inject_blocks(line: str) -> str:
    """Insert GPU block before clock in an i3bar payload line."""
    raw = line.rstrip("\n")
    if not raw or raw in ("[", "]"):
        return line
    prefix = ""
    body = raw
    if body.startswith(","):
        prefix = ","
        body = body[1:]
    try:
        blocks = json.loads(body)
    except json.JSONDecodeError:
        return line
    if not isinstance(blocks, list):
        return line

    gpu = gpu_block()
    # remove prior injected block if any
    blocks = [b for b in blocks if not (isinstance(b, dict) and b.get("name") == "gpu_temp")]

    # place GPU immediately before tztime; else append
    idx = next(
        (i for i, b in enumerate(blocks) if isinstance(b, dict) and b.get("name") == "tztime"),
        len(blocks),
    )
    blocks.insert(idx, gpu)
    return prefix + json.dumps(blocks) + "\n"


def handle_clicks() -> None:
    # i3bar sends an infinite JSON array on stdin, one event per click.
    for raw in sys.stdin:
        raw = raw.strip()
        if not raw or raw in ("[", "]"):
            continue
        if raw.startswith(","):
            raw = raw[1:]
        try:
            event = json.loads(raw)
        except json.JSONDecodeError:
            continue
        name = event.get("name")
        button = event.get("button")
        # left-click date/clock block
        if name == "tztime" and button == 1:
            open_calendar()


def main() -> int:
    proc = subprocess.Popen(
        ["i3status", "-c", CONFIG],
        stdout=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    assert proc.stdout is not None

    threading.Thread(target=handle_clicks, daemon=True).start()

    header_line = proc.stdout.readline()
    try:
        header = json.loads(header_line.strip())
    except json.JSONDecodeError:
        header = {"version": 1}
    header["click_events"] = True
    sys.stdout.write(json.dumps(header) + "\n")
    sys.stdout.flush()

    # skip the opening "[" line if present, then stream updates
    for line in proc.stdout:
        sys.stdout.write(inject_blocks(line))
        sys.stdout.flush()

    return proc.wait()


if __name__ == "__main__":
    raise SystemExit(main())
