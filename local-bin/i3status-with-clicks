#!/usr/bin/env python3
"""i3status wrapper: calendar click + GPU temp + system RAM + LLM tok/s."""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
from collections import deque
from pathlib import Path

CONFIG = os.path.expanduser("~/.config/i3status/config")
HOME = os.path.expanduser("~")

GPU_COLOR = "#e74c3c"  # red
MEM_COLOR = "#e8e8e8"
SEP_COLOR = "#5F676F"  # Pi footer separator
GPU_REFRESH_SEC = 3.0
TOK_REFRESH_SEC = 1.0
TOK_AVG_WINDOW_SEC = 30.0
TOK_BASE = "http://127.0.0.1:8888"
TOK_COLOR = "#e8e8e8"
TOK_STICKY_SEC = 6.0
GEN_RE = re.compile(
    r"^(?:vllm:generation_tokens_total|sglang:generation_tokens_total|sglang_generation_tokens_total)"
    r"(?:\{[^}]*\})?\s+([0-9.eE+-]+)\s*$",
    re.M,
)

_gpu_lock = threading.Lock()
_gpu_temp = "n/a"
_gpu_mem = "n/a"
_gpu_ts = 0.0

_tok_lock = threading.Lock()
_tok_ts = 0.0
_tok_last_count = None
_tok_last_t = None
_tok_live = None
_tok_avg = None
_tok_ok = False
_tok_samples: deque[tuple[float, float]] = deque()
_tok_sticky_value = None
_tok_sticky_until = 0.0


def open_calendar() -> None:
    """Toggle/pop a small calendar near the bar (dark theme)."""
    launch = os.environ.copy()
    launch["PATH"] = f"{HOME}/.local/bin:" + launch.get("PATH", "")
    launch["GTK_THEME"] = launch.get("GSIMPLECAL_GTK_THEME", "Yaru-purple-dark")
    launch["GTK_APPLICATION_PREFER_DARK_THEME"] = "1"
    launch["GTK_FONT_NAME"] = launch.get("GSIMPLECAL_GTK_FONT", "Ubuntu Sans 13")
    launch["GDK_BACKEND"] = "x11"

    candidates = [
        [f"{HOME}/.local/bin/gsimplecal-i3"],
        ["gsimplecal"],
        ["gnome-calendar"],
        ["zenity", "--calendar", "--title=Calendar"],
    ]
    for cmd in candidates:
        try:
            subprocess.Popen(
                cmd,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                env=launch,
            )
            return
        except FileNotFoundError:
            continue


def read_meminfo() -> tuple[int, int] | None:
    """Return (available_kb, total_kb) from /proc/meminfo."""
    total = avail = None
    try:
        with open("/proc/meminfo", encoding="utf-8") as fh:
            for line in fh:
                if line.startswith("MemTotal:"):
                    total = int(line.split()[1])
                elif line.startswith("MemAvailable:"):
                    avail = int(line.split()[1])
                if total is not None and avail is not None:
                    return avail, total
    except OSError:
        return None
    return None


def read_gpu_temp() -> str | None:
    """Return GPU temp in C."""
    try:
        out = subprocess.check_output(
            [
                "nvidia-smi",
                "--query-gpu=temperature.gpu",
                "--format=csv,noheader,nounits",
            ],
            text=True,
            timeout=2.0,
            stderr=subprocess.DEVNULL,
        )
        token = out.strip().splitlines()[0].strip().split(",")[0].split()[0]
        int(token)
        return token
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError, ValueError, IndexError):
        return None


def pango_item(text: str, color: str) -> str:
    return (
        f"<span foreground='{color}'>{text}</span>"
        f"<span foreground='{SEP_COLOR}'> | </span>"
    )


def stat_block(name: str, instance: str, text: str, color: str) -> dict:
    return {
        "name": name,
        "instance": instance,
        "full_text": pango_item(text, color),
        "markup": "pango",
        "separator": False,
        "separator_block_width": 0,
    }


def _http_get(url: str, timeout: float = 0.6) -> str | None:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as resp:
            if getattr(resp, "status", 200) >= 400:
                return None
            return resp.read().decode("utf-8", "replace")
    except (urllib.error.URLError, TimeoutError, OSError):
        return None


def _parse_prom_counter(body: str) -> float | None:
    matches = GEN_RE.findall(body)
    if not matches:
        return None
    try:
        return float(matches[-1])
    except ValueError:
        return None


def _sglang_last_gen(data: object) -> float | None:
    if not isinstance(data, dict):
        return None
    top = data.get("last_gen_throughput")
    try:
        if top is not None:
            n = float(top)
            if n >= 0:
                return n
    except (TypeError, ValueError):
        pass
    states = data.get("internal_states")
    if not isinstance(states, list):
        return None
    best = None
    for st in states:
        if not isinstance(st, dict):
            continue
        try:
            n = float(st.get("last_gen_throughput"))
        except (TypeError, ValueError):
            continue
        if n < 0:
            continue
        if best is None or n > best:
            best = n
    return best


def _sglang_output_tokens(data: object) -> float | None:
    if not isinstance(data, dict):
        return None
    raw = data.get("total_output_tokens")
    try:
        if raw is None:
            return None
        return float(raw)
    except (TypeError, ValueError):
        return None


def read_tok_sample() -> tuple[str, float] | None:
    """Return ("counter", tokens) or ("gauge", tok/s)."""
    metrics = _http_get(f"{TOK_BASE}/metrics")
    if metrics:
        count = _parse_prom_counter(metrics)
        if count is not None:
            return ("counter", count)
    info = _http_get(f"{TOK_BASE}/get_server_info")
    if not info:
        return None
    try:
        data = json.loads(info)
    except json.JSONDecodeError:
        return None
    out = _sglang_output_tokens(data)
    if out is not None:
        return ("counter", out)
    gauge = _sglang_last_gen(data)
    if gauge is None:
        return None
    return ("gauge", gauge)


def update_tok() -> None:
    """vLLM/SGLang Prometheus counters, else SGLang last_gen_throughput."""
    global _tok_ts, _tok_last_count, _tok_last_t, _tok_live, _tok_avg, _tok_ok
    global _tok_sticky_value, _tok_sticky_until
    now = time.time()
    with _tok_lock:
        if now - _tok_ts < TOK_REFRESH_SEC:
            return
        sample = read_tok_sample()
        _tok_ts = now
        if sample is None:
            _tok_ok = False
            _tok_live = None
            return
        kind, value = sample
        _tok_ok = True
        live = 0.0
        if kind == "counter":
            if _tok_last_count is not None and _tok_last_t is not None:
                dt = now - _tok_last_t
                dc = value - _tok_last_count
                if dt > 0.2 and dc >= 0:
                    live = dc / dt
            _tok_last_count = value
            _tok_last_t = now
        else:
            rounded = round(value, 2)
            if _tok_sticky_value is None:
                _tok_sticky_value = rounded
                _tok_sticky_until = now + TOK_STICKY_SEC if rounded > 0.5 else 0.0
                live = rounded if rounded > 0.5 else 0.0
            elif rounded != _tok_sticky_value:
                _tok_sticky_value = rounded
                _tok_sticky_until = now + TOK_STICKY_SEC
                live = rounded
            elif now < _tok_sticky_until:
                live = rounded
            else:
                live = 0.0
        _tok_live = live
        _tok_samples.append((now, live))
        cutoff = now - TOK_AVG_WINDOW_SEC
        while _tok_samples and _tok_samples[0][0] < cutoff:
            _tok_samples.popleft()
        vals = [v for _, v in _tok_samples]
        _tok_avg = (sum(vals) / len(vals)) if vals else 0.0


def tok_text() -> str | None:
    update_tok()
    with _tok_lock:
        if not _tok_ok or _tok_live is None:
            return None
        live = _tok_live
    if live < 0.5:
        return "Tok/sec: 0"
    return f"Tok/sec: {live:.0f}"


def extra_blocks() -> list[dict]:
    """Mem + GPU temp + tok/s."""
    global _gpu_temp, _gpu_ts
    now = time.time()
    with _gpu_lock:
        if now - _gpu_ts >= GPU_REFRESH_SEC:
            temp = read_gpu_temp()
            _gpu_temp = f"Temp: {temp}°C" if temp is not None else "Temp: n/a"
            _gpu_ts = now
        gpu_temp = _gpu_temp

    ram_text = "Mem: n/a"
    info = read_meminfo()
    if info is not None:
        avail_kb, total_kb = info
        used_pct = max(0, min(100, int(round(100.0 * (1.0 - avail_kb / total_kb)))))
        ram_text = f"Mem: {used_pct}%"

    out = []
    tok = tok_text()
    if tok is not None:
        out.append(stat_block("llm_tps", "vllm", tok, TOK_COLOR))
    out.append(stat_block("cpu_mem", "host", ram_text, MEM_COLOR))
    out.append(stat_block("gpu_temp", "nvidia0", gpu_temp, GPU_COLOR))
    return out


def inject_blocks(line: str) -> str:
    raw = line.rstrip("\n")
    if not raw or raw in ("[", "]"):
        return line
    prefix = ""
    body = raw
    if body.startswith(","):
        prefix = ","
        body = body[1:]
    try:
        blocks = json.loads(body)
    except json.JSONDecodeError:
        return line
    if not isinstance(blocks, list):
        return line

    skip = {"gpu_temp", "gpu_mem", "cpu_mem", "llm_tps"}
    blocks = [b for b in blocks if not (isinstance(b, dict) and b.get("name") in skip)]
    idx = next(
        (i for i, b in enumerate(blocks) if isinstance(b, dict) and b.get("name") == "tztime"),
        len(blocks),
    )
    for offset, blk in enumerate(extra_blocks()):
        blocks.insert(idx + offset, blk)
    return prefix + json.dumps(blocks) + "\n"


def handle_clicks() -> None:
    for raw in sys.stdin:
        raw = raw.strip()
        if not raw or raw in ("[", "]"):
            continue
        if raw.startswith(","):
            raw = raw[1:]
        try:
            event = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if event.get("name") == "tztime" and event.get("button") == 1:
            open_calendar()


def main() -> int:
    proc = subprocess.Popen(
        ["i3status", "-c", CONFIG],
        stdout=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    assert proc.stdout is not None

    threading.Thread(target=handle_clicks, daemon=True).start()

    header_line = proc.stdout.readline()
    try:
        header = json.loads(header_line.strip())
    except json.JSONDecodeError:
        header = {"version": 1}
    header["click_events"] = True
    sys.stdout.write(json.dumps(header) + "\n")
    sys.stdout.flush()

    for line in proc.stdout:
        sys.stdout.write(inject_blocks(line))
        sys.stdout.flush()

    return proc.wait()


if __name__ == "__main__":
    raise SystemExit(main())
