#!/usr/bin/env python3
"""Render CALIPER ASCII wordmark on true black for the i3 root window."""
from __future__ import annotations

import os
from pathlib import Path

from PIL import Image, ImageDraw, ImageFont

OUT = Path(os.environ.get("I3_WALLPAPER", Path.home() / ".local/share/wallpapers/caliper.png"))
W = int(os.environ.get("I3_WALL_W", "2560"))
H = int(os.environ.get("I3_WALL_H", "1440"))
BG = (0, 0, 0)
FG = (232, 232, 232)  # #e8e8e8

WORDMARK = """\
######    ##    ##      ##  ######  #######  ######
##   ##  ####   ##      ##  ##   ## ##       ##   ##
##      ##  ##  ##      ##  ######  #####    ######
##      ######  ##      ##  ##      ##       ##  ##
###### ##    ## ####### ##  ##      #######  ##   ##
"""


def font(size: int) -> ImageFont.FreeTypeFont | ImageFont.ImageFont:
    for path in (
        Path("/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"),
        Path("/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"),
        Path.home() / ".local/share/fonts/JetBrainsMonoNerdFontMono-Regular.ttf",
    ):
        if path.is_file():
            try:
                return ImageFont.truetype(str(path), size)
            except OSError:
                continue
    return ImageFont.load_default()


def main() -> int:
    img = Image.new("RGB", (W, H), BG)
    draw = ImageDraw.Draw(img)
    fnt = font(16)
    lines = [ln.rstrip() for ln in WORDMARK.strip("\n").splitlines()]
    width = max(len(ln) for ln in lines)
    lines = [ln.ljust(width) for ln in lines]
    block = "\n".join(lines)
    box = draw.multiline_textbbox((0, 0), block, font=fnt, spacing=4)
    tw, th = box[2] - box[0], box[3] - box[1]
    x = (W - tw) // 2 - box[0]
    y = (H - th) // 2 - box[1]
    draw.multiline_text((x, y), block, font=fnt, fill=FG, spacing=4)
    OUT.parent.mkdir(parents=True, exist_ok=True)
    img.save(OUT, "PNG")
    print(OUT)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
