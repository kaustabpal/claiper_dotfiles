# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4
set $accent #8e44ad
# Terminal verified present on this host (snap ghostty via x-terminal-emulator).
set $term ghostty

# ---------------------------------------------------------------------------
# Display pin (i3-session only). Do not put this in ~/.profile or ~/.bashrc.
# Keep this mode identical to GNOME baseline to avoid UI scale breakage.
# ---------------------------------------------------------------------------
exec --no-startup-id xrandr --output HDMI-0 --mode 2560x1440 --scale 1x1

# Set solid black wallpaper
# Desktop: CALIPER ASCII wordmark on true black
exec --no-startup-id /home/kaustab/.local/bin/i3-render-wallpaper
exec --no-startup-id feh --bg-fill /home/kaustab/.local/share/wallpapers/caliper.png

exec --no-startup-id /home/kaustab/.local/bin/i3-apply-theme-env

# Font for window titles and i3bar. Readable on 2560x1440; fix size here only.
font pango:JetBrainsMono Nerd Font Mono 15

# XDG autostart via dex can pull GNOME helpers into i3 and fight the session.
# Keep disabled unless a specific autostart entry is required.
# exec --no-startup-id dex --autostart --environment i3

# xss-lock / i3lock are not installed on this host currently.
# Install both before enabling lock-on-suspend.
# exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# NetworkManager tray applet
exec --no-startup-id /home/kaustab/.local/bin/nm-applet-themed
exec --no-startup-id pgrep -x dunst >/dev/null || dunst
exec --no-startup-id /home/kaustab/.local/bin/i3-stop-gnome-agents

# Volume (PipeWire via wpctl). XF86 keys + Super fallbacks.
bindsym XF86AudioRaiseVolume exec --no-startup-id /home/kaustab/.local/bin/i3-volume up
bindsym XF86AudioLowerVolume exec --no-startup-id /home/kaustab/.local/bin/i3-volume down
bindsym XF86AudioMute exec --no-startup-id /home/kaustab/.local/bin/i3-volume mute
bindsym XF86AudioMicMute exec --no-startup-id /home/kaustab/.local/bin/i3-volume mic
bindsym $mod+equal exec --no-startup-id /home/kaustab/.local/bin/i3-volume up
bindsym $mod+minus exec --no-startup-id /home/kaustab/.local/bin/i3-volume down
bindsym $mod+Shift+m exec --no-startup-id /home/kaustab/.local/bin/i3-volume mute

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# start a terminal
bindsym $mod+Return exec --no-startup-id $term

# lock screen (slock). Power menu is rofi-only: $mod+Shift+e
bindsym --release $mod+Shift+x exec --no-startup-id /home/kaustab/.local/bin/i3-lock

# capture (area only) — maim/slop/ffmpeg + dunst notifications
# --release: keys up before pointer grab
# Super+Shift+s = area screenshot
# Super+Shift+v = area record start, OR stop if already recording
bindsym --release $mod+Shift+s exec --no-startup-id /home/kaustab/.local/bin/screen-capture area
bindsym --release $mod+Shift+v exec --no-startup-id /home/kaustab/.local/bin/screen-capture record

# Browser back/forward (Super is $mod; Ctrl+Left/Right = history)
# Ctrl+Left/Right when browser focused → browser-nav (mouse btn 8/9 / XF86*)
bindsym Ctrl+Left [class="firefox|firefox_firefox|Navigator|brave-browser|Brave-browser|Chromium|Google-chrome|chromium"] exec --no-startup-id /home/kaustab/.local/bin/browser-nav back
bindsym Ctrl+Right [class="firefox|firefox_firefox|Navigator|brave-browser|Brave-browser|Chromium|Google-chrome|chromium"] exec --no-startup-id /home/kaustab/.local/bin/browser-nav forward

# kill focused window
bindsym $mod+Shift+q kill

# app launcher (rofi; theme: ~/.config/rofi/config.rasi)
# Super+Space = app launcher; Super+Shift+d = PATH run dialog
bindsym $mod+space exec --no-startup-id /home/kaustab/.local/bin/rofi-drun-recent
bindsym $mod+Shift+d exec --no-startup-id rofi -show run -no-disable-history

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+Shift+t focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec --no-startup-id /home/kaustab/.local/bin/i3-power-menu

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Window border settings
# With Xft.dpi=96 (see ~/.local/bin/i3-session), pixel 3 == 3 device px.
# Adjacent tiled windows still sit border-to-border (3+3=6 between panes).
default_border pixel 3
default_floating_border pixel 3
# Only decorate normal windows. Pixel borders on GTK/Firefox menus
# collapse them into thin rectangles and break popups.
for_window [window_type="normal"] border pixel 3
for_window [window_type="dialog"] floating enable, border pixel 3
for_window [window_type="utility"] floating enable, border pixel 3
for_window [window_type="toolbar"] floating enable
for_window [window_type="splash"] floating enable
for_window [window_type="menu"] floating enable, border none
for_window [window_type="dropdown_menu"] floating enable, border none
for_window [window_type="popup_menu"] floating enable, border none
for_window [window_type="tooltip"] floating enable, border none
for_window [window_type="notification"] floating enable, border none
for_window [class="firefox_firefox" window_role="GtkFileChooserDialog"] floating enable
for_window [class="firefox_firefox" window_role="Dialog"] floating enable
for_window [class="firefox_firefox" window_role="About"] floating enable

# Window border colors (match bar palette)
client.focused          $accent $accent #ffffff $accent $accent
client.focused_inactive #2a2a2a #2a2a2a #bbbbbb #2a2a2a #2a2a2a
client.unfocused        #1c1c1c #1c1c1c #777777 #1c1c1c #1c1c1c
client.urgent           #e74c3c #e74c3c #ffffff #e74c3c #e74c3c
client.placeholder      #1c1c1c #1c1c1c #ffffff #1c1c1c #1c1c1c
client.background       #1c1c1c

# gsimplecal popup (clock click)
for_window [class="[Gg]simplecal"] floating enable, border pixel 3, focus
for_window [class="[Rr]ofi"] floating enable, sticky enable, border pixel 0
for_window [class="I3ConsoleLock"] fullscreen enable, floating enable, border none, sticky enable

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
        position top
        # cleaner density on 2560x1440
        height 36
        tray_padding 10
        workspace_min_width 36
        separator_symbol " "
        font pango:JetBrainsMono Nerd Font Mono 13
        status_command /home/kaustab/.local/bin/i3status-with-clicks
        strip_workspace_numbers yes
        colors {
                # bg border text
                background              #1c1c1c
                statusline              #e8e8e8
                separator               #1c1c1c
                focused_background      #1c1c1c
                focused_statusline      #e8e8e8
                focused_separator       #1c1c1c

                # border bg text
                focused_workspace       $accent $accent #ffffff
                active_workspace        #2a2a2a #2a2a2a #dddddd
                inactive_workspace      #1c1c1c #1c1c1c #777777
                urgent_workspace        #e74c3c #e74c3c #ffffff
                binding_mode            $accent $accent #ffffff
        }
}
